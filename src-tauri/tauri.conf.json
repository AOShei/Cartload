{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartload",
  "version": "0.2.1",
  "identifier": "org.cartload.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cartload",
        "width": 1600,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: cover: http://cover.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Install hakchi and manage games on Classic Mini consoles",
    "longDescription": "Cartload installs the hakchi kernel on NES, SNES and Famicom Classic Mini consoles and manages and syncs a games library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/lib/udev/rules.d/70-cartload.rules": "linux/70-cartload.rules"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "copyright": "GPL-3.0-or-later",
    "homepage": "https://github.com/AOShei/Cartload",
    "publisher": "Andrew O'Shei"
  },
  "mainBinaryName": "cartload"
}
