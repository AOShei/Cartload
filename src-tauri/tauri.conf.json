{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartload",
  "version": "0.1.0",
  "identifier": "org.cartload.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cartload",
        "width": 1024,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Install hakchi and manage games on Classic Mini consoles",
    "longDescription": "Cartload installs the hakchi kernel on NES, SNES and Mega Drive Classic Mini consoles and manages and syncs a games library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
