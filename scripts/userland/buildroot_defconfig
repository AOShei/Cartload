# Buildroot 2015.11.1: the toolchain of hakchi v1.0.4-126's binaries (their .comment reads
# "GCC: (Buildroot 2015.11.1) 4.9.3"; libc is "GNU C Library (Buildroot) 2.22"). Reduced from
# hakchi.net's /hakchi/sdk/(dot)config by switching every package off. Its defaults already give
# GCC 4.9.3, binutils 2.24 and kernel headers 4.3, as that config has.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_SHARED_STATIC_LIBS=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_GLIBC_VERSION_2_22=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_ENABLE_LTO=y
BR2_GCC_ENABLE_OPENMP=y
BR2_GCC_ENABLE_GRAPHITE=y
BR2_ENABLE_LOCALE_PURGE=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US.UTF-8"
BR2_BACKUP_SITE="http://sources.buildroot.net"

# Packages whose shipped version is the one this Buildroot carries, built with its recipes and
# madmonkey's options for them. No OpenSSL or libgcrypt: the shipped cryptsetup links neither
# (Buildroot then uses the kernel crypto API).
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LIBBLKID=y
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y
BR2_PACKAGE_POPT=y
BR2_PACKAGE_LVM2=y
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_FBGRAB=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y

# Newer sources (local.mk), with madmonkey's options.
BR2_PACKAGE_OVERRIDE_FILE="/repo/scripts/userland/local.mk"
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_E2FSPROGS_TUNE2FS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_DROPBEAR_SMALL=y
BR2_PACKAGE_KEXEC=y
# no BR2_PACKAGE_KEXEC_ZLIB: the shipped kexec links no libz
BR2_PACKAGE_RSYNC=y
