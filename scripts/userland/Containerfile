# Build environment for the console userland (see build.sh): Buildroot 2015.11.1 builds the
# toolchain hakchi v1.0.4-126's binaries were built with (GCC 4.9.3, glibc 2.22). Ubuntu 16.04 is
# old enough for that Buildroot's host tools.
FROM docker.io/library/ubuntu:16.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential bc bzip2 ca-certificates cpio file git gzip libncurses5-dev patch perl \
      python rsync unzip wget xz-utils texinfo gawk locales \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8
# Buildroot refuses to build a toolchain with locales without a UTF-8 locale on the host.
ENV LANG=en_US.UTF-8
